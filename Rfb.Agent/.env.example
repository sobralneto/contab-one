# Copie para .env (que esta no .gitignore) e preencha.
# O .env guarda segredos; nunca versione.

# ---------------------------------------------------------------------------
# Certificado digital A1 (modo playwright_pfx)
# ---------------------------------------------------------------------------
# Senha do arquivo .pfx que esta na pasta certificado/. O robo encontra o
# .pfx sozinho, pelo unico arquivo daquela pasta -- so a senha vem daqui.
RFB_PFX_SENHA=

