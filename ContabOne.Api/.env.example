# Variáveis de ambiente obrigatórias da ContabOne.Api.
# Copie para o ambiente (Railway dashboard, shell, etc.) — não commite valores reais.

# Connection string Postgres (o Railway entrega `postgresql://...` — a API converte).
DATABASE_URL=

# Chave de assinatura dos JWTs (usuários do frontend).
JWT_SIGNING_KEY=

# ⚠️ PERMANENTE — NUNCA troque depois que clientes existirem.
# Usada para ofuscar CNPJs (CnpjHash) enviados pelo agente. Trocá-la invalida
# todos os hashes já gravados e duplica todos os clientes no próximo handshake.
# O boot da API FALHA sem esta variável — por design, para o envio de métricas
# não morrer em silêncio.
HMAC_CNPJ_KEY=

# Origem permitida para CORS no frontend (produção). Separada por vírgula.
CORS_ORIGINS=

# Opcional: ASPNETCORE_ENVIRONMENT (Development habilita os endpoints /api/seed).
ASPNETCORE_ENVIRONMENT=
